# ====================================================
# HireLoop Server Environment Template (.env.example)
# Copy this file to .env and fill in values for your deployment
# ====================================================

PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas connection string)
DB_URI=mongodb+srv://<username>:<password>@cluster0.lldqhrj.mongodb.net/
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Frontend Client URL(s) allowed by CORS
# (e.g. https://your-hireloop.vercel.app or comma-separated list of origins)
CLIENT_URL=https://your-hireloop.vercel.app

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
